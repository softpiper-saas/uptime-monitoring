<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Oxygen, Ubuntu, Cantarell, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        color: #333;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
      }

      .header {
        text-align: center;
        color: white;
        margin-bottom: 30px;
      }

      .header h1 {
        font-size: 2.5rem;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
      }

      .header p {
        font-size: 1.1rem;
        opacity: 0.9;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
      }

      .stat-card {
        background: white;
        padding: 20px;
        border-radius: 10px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease;
      }

      .stat-card:hover {
        transform: translateY(-2px);
      }

      .stat-number {
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 5px;
      }

      .stat-label {
        color: #666;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .stat-up {
        color: #10b981;
      }
      .stat-down {
        color: #ef4444;
      }
      .stat-total {
        color: #3b82f6;
      }
      .stat-uptime {
        color: #8b5cf6;
      }

      .services-section {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
      }

      .section-title {
        font-size: 1.5rem;
        margin-bottom: 20px;
        color: #333;
        border-bottom: 2px solid #f3f4f6;
        padding-bottom: 10px;
      }

      .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 15px;
      }

      .service-card {
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        padding: 15px;
        transition: all 0.2s ease;
      }

      .service-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }

      .service-card.up {
        border-color: #10b981;
        background-color: #ecfdf5;
      }

      .service-card.down {
        border-color: #ef4444;
        background-color: #fef2f2;
      }

      .service-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
      }

      .service-name {
        font-weight: 600;
        font-size: 1rem;
      }

      .service-status {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
      }

      .status-up {
        background-color: #10b981;
        color: white;
      }

      .status-down {
        background-color: #ef4444;
        color: white;
      }

      .service-details {
        font-size: 0.9rem;
        color: #666;
      }

      .service-details div {
        margin-bottom: 5px;
      }

      .service-id {
        color: #5b21b6;
        font-size: 0.8rem;
        font-style: italic;
        margin-top: 5px;
        font-weight: 800;
      }

      .service-type {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-right: 8px;
      }

      .service-type.ping {
        background: #dbeafe;
        color: #1e40af;
      }

      .service-type.http {
        background: #d1fae5;
        color: #065f46;
      }

      .service-type.database {
        background: #fef3c7;
        color: #92400e;
      }

      .service-type.ssl {
        background: #e0e7ff;
        color: #3730a3;
      }

      .service-type.backup {
        background: #e5e7eb;
        color: #4b5563;
      }

      .uptime-badge {
        display: inline-block;
        background: #ddd6fe;
        color: #5b21b6;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
      }

      .ssl-info {
        margin-top: 8px;
        padding: 8px;
        background: #f8fafc;
        border-radius: 6px;
        font-size: 0.8rem;
      }

      .ssl-expiring {
        background: #fef3c7;
        border-left: 3px solid #f59e0b;
      }

      .ssl-expired {
        background: #fecaca;
        border-left: 3px solid #ef4444;
      }

      .refresh-button {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: #3b82f6;
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
        transition: all 0.2s ease;
      }

      .refresh-button:hover {
        background: #2563eb;
        transform: translateY(-2px);
      }

      .refresh-button:active {
        transform: translateY(0);
        background: #1d4ed8;
      }

      .refresh-button.refreshing {
        background: #6b7280;
        cursor: not-allowed;
        animation: spin 1s linear infinite;
      }

      .refresh-button:disabled {
        background: #6b7280;
        cursor: not-allowed;
        opacity: 0.6;
      }

      @keyframes spin {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }

      .last-updated {
        text-align: center;
        color: #6b7280;
        font-size: 0.9rem;
        margin-top: 20px;
      }

      @media (max-width: 768px) {
        .header h1 {
          font-size: 2rem;
        }

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .services-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>🚀 <%= title %></h1>
        <p>Real-time monitoring of your services and infrastructure</p>
      </div>

      <!-- Statistics Cards -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number stat-total"><%= status.stats.total %></div>
          <div class="stat-label">Total Services</div>
        </div>
        <div class="stat-card">
          <div class="stat-number stat-up"><%= status.stats.up %></div>
          <div class="stat-label">Services Up</div>
        </div>
        <div class="stat-card">
          <div class="stat-number stat-down"><%= status.stats.down %></div>
          <div class="stat-label">Services Down</div>
        </div>
        <div class="stat-card">
          <div class="stat-number stat-uptime">
            <%= status.stats.averageUptime.toFixed(1) %>%
          </div>
          <div class="stat-label">Average Uptime</div>
        </div>
      </div>

      <!-- Services Down (if any) -->
      <% if (status.downServices.length > 0) { %>
      <div class="services-section">
        <h2 class="section-title">
          🔴 Services Currently Down (<%= status.downServices.length %>)
        </h2>
        <div class="services-grid">
          <% status.downServices.forEach(function(service) { %>
          <div class="service-card down">
            <div class="service-header">
              <div class="service-name"><%= service.name %></div>
              <div class="service-status status-down">Down</div>
            </div>
            <div class="service-details">
              <div>
                <span
                  class="service-type <%= service.type === 'ping' ? 'ping' : service.type === 'http' ? 'http' : service.type === 'database' ? 'database' : service.type === 'ssl' ? 'ssl' : service.type === 'backup' ? 'backup' : '' %>"
                >
                  <%= service.type === 'ping' ? 'PING' : service.type === 'http'
                  ? 'HTTP/HTTPS' : service.type === 'database' ? 'DATABASE' :
                  service.type === 'ssl' ? 'SSL CERT' : service.type ===
                  'backup' ? 'BACKUP' : service.type.toUpperCase() %>
                </span>
                <span class="uptime-badge"
                  ><%= service.uptime.toFixed(1) %>% uptime</span
                >
              </div>
              <div>Failures: <%= service.consecutiveFailures %></div>
              <div>
                Last checked: <%= new Date(service.lastChecked).toLocaleString()
                %>
              </div>
              <div class="service-id">ID: <%= service.id %></div>
              <% if (service.error) { %>
              <div style="color: #dc2626; margin-top: 5px">
                <strong>Error:</strong> <%= service.error %>
              </div>
              <% } %> <% if (service.sslInfo) { %>
              <div
                class="ssl-info <%= service.sslInfo.isExpired ? 'ssl-expired' : (service.sslInfo.isExpiringSoon ? 'ssl-expiring' : '') %>"
              >
                <strong>SSL Certificate:</strong>
                <% if (service.sslInfo.isExpired) { %> ❌ Expired <%=
                service.sslInfo.daysUntilExpiry %> days ago <% } else if
                (service.sslInfo.isExpiringSoon) { %> ⚠️ Expires in <%=
                service.sslInfo.daysUntilExpiry %> days <% } else { %> ✅ Valid
                for <%= service.sslInfo.daysUntilExpiry %> days <% } %>
              </div>
              <% } %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <!-- Server Ping Services -->
      <% const serverServices = status.services.filter(service => service.type
      === 'ping'); const appServices = status.services.filter(service =>
      service.type === 'http'); const dbServices =
      status.services.filter(service => service.type === 'database'); const
      sslServices = status.services.filter(service => service.type === 'ssl');
      const backupServices = status.services.filter(service => service.type ===
      'backup'); %> <% if (serverServices.length > 0) { %>
      <div class="services-section">
        <h2 class="section-title">
          🖥️ Server Ping Monitoring (<%= serverServices.length %>)
        </h2>
        <div class="services-grid">
          <% serverServices.forEach(function(service) { %>
          <div class="service-card <%= service.status %>">
            <div class="service-header">
              <div class="service-name"><%= service.name %></div>
              <div class="service-status status-<%= service.status %>">
                <%= service.status === 'up' ? 'Up' : 'Down' %>
              </div>
            </div>
            <div class="service-details">
              <div>
                <span class="service-type ping">PING</span>
                <span class="uptime-badge"
                  ><%= service.uptime.toFixed(1) %>% uptime</span
                >
              </div>
              <div class="service-id">ID: <%= service.id %></div>
              <% if (service.status === 'down') { %>
              <div>Failures: <%= service.consecutiveFailures %></div>
              <% } %>
              <div>
                Last checked: <%= new Date(service.lastChecked).toLocaleString()
                %>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <!-- HTTP/HTTPS Applications -->
      <% if (appServices.length > 0) { %>
      <div class="services-section">
        <h2 class="section-title">
          🌐 Web Applications (<%= appServices.length %>)
        </h2>
        <div class="services-grid">
          <% appServices.forEach(function(service) { %>
          <div class="service-card <%= service.status %>">
            <div class="service-header">
              <div class="service-name"><%= service.name %></div>
              <div class="service-status status-<%= service.status %>">
                <%= service.status === 'up' ? 'Up' : 'Down' %>
              </div>
            </div>
            <div class="service-details">
              <div>
                <span class="service-type http">HTTP/HTTPS</span>
                <span class="uptime-badge"
                  ><%= service.uptime.toFixed(1) %>% uptime</span
                >
              </div>
              <% if (service.status === 'down') { %>
              <div>Failures: <%= service.consecutiveFailures %></div>
              <% } %>
              <div>
                Last checked: <%= new Date(service.lastChecked).toLocaleString()
                %>
              </div>
              <div class="service-id">ID: <%= service.id %></div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <!-- Database Services -->
      <% if (dbServices.length > 0) { %>
      <div class="services-section">
        <h2 class="section-title">
          🗄️ Database Services (<%= dbServices.length %>)
        </h2>
        <div class="services-grid">
          <% dbServices.forEach(function(service) { %>
          <div class="service-card <%= service.status %>">
            <div class="service-header">
              <div class="service-name"><%= service.name %></div>
              <div class="service-status status-<%= service.status %>">
                <%= service.status === 'up' ? 'Up' : 'Down' %>
              </div>
            </div>
            <div class="service-details">
              <div>
                <span class="service-type database">DATABASE</span>
                <span class="uptime-badge"
                  ><%= service.uptime.toFixed(1) %>% uptime</span
                >
              </div>
              <% if (service.status === 'down') { %>
              <div>Failures: <%= service.consecutiveFailures %></div>
              <% } %>
              <div>
                Last checked: <%= new Date(service.lastChecked).toLocaleString()
                %>
              </div>
              <div class="service-id">ID: <%= service.id %></div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <!-- SSL Certificate Monitoring -->
      <% if (sslServices.length > 0) { %>
      <div class="services-section">
        <h2 class="section-title">
          🔒 SSL Certificate Monitoring (<%= sslServices.length %>)
        </h2>
        <div class="services-grid">
          <% sslServices.forEach(function(service) { %>
          <div class="service-card <%= service.status %>">
            <div class="service-header">
              <div class="service-name"><%= service.name %></div>
              <div class="service-status status-<%= service.status %>">
                <%= service.status === 'up' ? 'Valid' : 'Invalid' %>
              </div>
            </div>
            <div class="service-details">
              <div>
                <span class="service-type ssl">SSL CERT</span>
                <span class="uptime-badge"
                  ><%= service.uptime.toFixed(1) %>% uptime</span
                >
              </div>
              <% if (service.status === 'down') { %>
              <div>Failures: <%= service.consecutiveFailures %></div>
              <% } %>
              <div>
                Last checked: <%= new Date(service.lastChecked).toLocaleString()
                %>
              </div>
              <div class="service-id">ID: <%= service.id %></div>
              <% if (service.sslInfo) { %>
              <div
                class="ssl-info <%= service.sslInfo.isExpired ? 'ssl-expired' : (service.sslInfo.isExpiringSoon ? 'ssl-expiring' : '') %>"
              >
                <strong>Certificate Status:</strong>
                <% if (service.sslInfo.isExpired) { %>
                <div>
                  ❌ Expired <%= Math.abs(service.sslInfo.daysUntilExpiry) %>
                  days ago
                </div>
                <div>
                  Valid until: <%= new
                  Date(service.sslInfo.validTo).toLocaleDateString() %>
                </div>
                <% } else if (service.sslInfo.isExpiringSoon) { %>
                <div>
                  ⚠️ Expires in <%= service.sslInfo.daysUntilExpiry %> days
                </div>
                <div>
                  Valid until: <%= new
                  Date(service.sslInfo.validTo).toLocaleDateString() %>
                </div>
                <% } else { %>
                <div>
                  ✅ Valid for <%= service.sslInfo.daysUntilExpiry %> days
                </div>
                <div>
                  Valid until: <%= new
                  Date(service.sslInfo.validTo).toLocaleDateString() %>
                </div>
                <% } %>
                <div>
                  <strong>Issuer:</strong> <%= service.sslInfo.issuer %>
                </div>
                <div>
                  <strong>Subject:</strong> <%= service.sslInfo.subject %>
                </div>
              </div>
              <% } %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <!-- Backup Monitoring -->
      <% if (backupServices.length > 0) { %>
      <div class="services-section">
        <h2 class="section-title">
          💾 Backup Monitoring (<%= backupServices.length %>)
        </h2>
        <div class="services-grid">
          <% backupServices.forEach(function(service) { %>
          <div class="service-card <%= service.status %>">
            <div class="service-header">
              <div class="service-name"><%= service.name %></div>
              <div class="service-status status-<%= service.status %>">
                <%= service.status === 'up' ? 'OK' : 'Failed' %>
              </div>
            </div>
            <div class="service-details">
              <div>
                <span class="service-type backup">BACKUP</span>
                <span class="uptime-badge"
                  ><%= service.uptime.toFixed(1) %>% uptime</span
                >
              </div>
              <% if (service.status === 'down') { %>
              <div>Failures: <%= service.consecutiveFailures %></div>
              <% } %>
              <div>
                Last checked: <%= new Date(service.lastChecked).toLocaleString()
                %>
              </div>
              <div class="service-id">ID: <%= service.id %></div>
              <% if (service.message) { %>
              <div><%= service.message %></div>
              <% } %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <div class="last-updated">
        Last updated: <%= new Date(currentTime).toLocaleString() %>
      </div>
    </div>

    <button class="refresh-button" id="refreshBtn">🔄 Refresh</button>

    <!-- Auto-refresh every 30 seconds -->
    <script>
      // Manual refresh button
      const refreshBtn = document.getElementById("refreshBtn");

      refreshBtn.addEventListener("click", function () {
        // Add visual feedback
        refreshBtn.classList.add("refreshing");
        refreshBtn.innerHTML = "⏳ Refreshing...";
        refreshBtn.disabled = true;

        // Small delay to show the loading state
        setTimeout(function () {
          try {
            window.location.reload(true); // Force reload from server
          } catch (error) {
            console.error("Error refreshing page:", error);
            // Fallback method
            window.location.href = window.location.href;
          }
        }, 200);
      });

      // Auto-refresh every 30 seconds
      let autoRefreshTimer = setTimeout(function () {
        try {
          window.location.reload(true);
        } catch (error) {
          console.error("Error during auto-refresh:", error);
          window.location.href = window.location.href;
        }
      }, 30000);

      // Clear timer if user navigates away
      window.addEventListener("beforeunload", function () {
        if (autoRefreshTimer) {
          clearTimeout(autoRefreshTimer);
        }
      });

      // Show countdown for auto-refresh
      let countdown = 30;
      let countdownInterval = setInterval(function () {
        countdown--;
        if (countdown <= 5 && countdown > 0) {
          refreshBtn.innerHTML = `🔄 Auto-refresh in ${countdown}s`;
        } else if (countdown === 0) {
          refreshBtn.innerHTML = "⏳ Refreshing...";
        }
      }, 1000);

      // Clear countdown on manual refresh
      refreshBtn.addEventListener("click", function () {
        clearInterval(countdownInterval);
      });
    </script>
  </body>
</html>
