{
  "name": "uptime-functional",
  "version": "1.0.0",
  "description": "Functional approach uptime monitoring application",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "NODE_TLS_REJECT_UNAUTHORIZED=0 drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "uptime",
    "monitoring",
    "express",
    "typescript",
    "functional",
    "drizzle"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.3",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "mongodb": "^6.21.0",
    "mysql2": "^3.15.3",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "ping": "^0.4.4",
    "postgres": "^3.4.3",
    "redis": "^5.10.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/mysql": "^2.15.27",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "@types/ping": "^0.4.4",
    "drizzle-kit": "^0.20.13",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
